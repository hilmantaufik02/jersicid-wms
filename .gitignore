# Laravel .gitignore (jersic-wms)

# Environment
/.env
/.env.backup
/.env.production
/phpunit.xml

# Dependencies
/vendor/
/node_modules/
/public/hot
/public/storage

# Build artifacts
/public/build
/public/assets
/.vite
/storage/*.key

# IDE & OS
/.idea
/.vscode
/.DS_Store
/Thumbs.db
*.swp
*.swo
*~

# Logs
/storage/logs/*.log

# Testing
/.phpunit.cache